[Unit]
Description=Ren - Standalone Trading AI Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
EnvironmentFile=/root/.ren.env
ExecStart=/usr/bin/python3 /root/ren_standalone.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

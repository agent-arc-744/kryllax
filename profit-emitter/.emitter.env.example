# Perpetual Giving Engine — Profit Emitter Environment
# Copy to /root/.emitter.env and fill in real values
# chmod 600 /root/.emitter.env

# ── Donor Identity ──────────────────────────────────────────────────────────
# DGB address of the loop-bot wallet (used to derive anonymous donor_id)
DONOR_WALLET_ADDRESS=DYourBotWalletAddressHere

# ── File Paths ───────────────────────────────────────────────────────────────
# Path to webhook_events.json on the VPS host (loop-bot volume mount)
EVENTS_FILE=/root/loop-bot/data/webhook_events.json

# Emitter state file (tracks processed event IDs)
STATE_FILE=/root/.emitter_state.json

# Log file
LOG_FILE=/root/profit_emitter.log

# ── Donation Settings ────────────────────────────────────────────────────────
# Percentage of each trade profit to encode as a donation (default: 10)
DONATION_PCT=10

# ── DGB Node RPC ─────────────────────────────────────────────────────────────
# Testnet: port 12022 | Mainnet: port 14022 | Regtest: 18443
DGB_RPC_HOST=127.0.0.1
DGB_RPC_PORT=12022
DGB_RPC_USER=dgbrpc
DGB_RPC_PASS=your_rpc_password_here

# ── Ren Notifications ────────────────────────────────────────────────────────
REN_WEBHOOK_URL=http://68.183.75.152:5001/inbox

# ── Polling ──────────────────────────────────────────────────────────────────
# Seconds between event file polls (default: 30)
POLL_INTERVAL=30

# ── Dry Run ──────────────────────────────────────────────────────────────────
# Set to 1 to encode schema but skip broadcast (safe testing mode)
DRY_RUN=0
